{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "S7Hmi": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ArchiverMode": "Sqlite",
  "ArchiverSettings": {
    "DefaultIntervalMs": 1000,
    "BatchSize": 1000,
    "BatchWaitMs": 500
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=scada_history.db;Cache=Shared;",
    "Postgres": "Host=localhost;Port=5432;Database=s7_scada;Username=postgres;Password=postgres;"
  },
  "PlcConnection": {
    "Id": "PLC-1",
    "Name": "Siemens S7-1500 Main",
    "IpAddress": "192.168.0.1",
    "Port": 102,
    "Rack": 0,
    "Slot": 1,
    "CpuType": "S71500",
    "PollingIntervalMs": 200,
    "TimeoutMs": 2000,
    "ReconnectIntervalMs": 5000,
    "MaxBatchSizeBytes": 480,
    "Enabled": true
  }
}
